<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<GridPane xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" hgap="20" vgap="20" style="-fx-background-color: #f8f9fa; -fx-padding: 40;">

    <!-- Welcome Section -->
    <VBox alignment="CENTER" spacing="15">
        <Label text="Bienvenue à Auto École" style="-fx-font-size: 24px; -fx-text-fill: #333; -fx-font-weight: bold;"/>
        <Label text="Gérez facilement votre auto-école avec notre application" style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
    </VBox>

    <!-- Navigation Buttons -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="Candidats" style="-fx-font-size: 14px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;"/>
        <Button text="Véhicules" style="-fx-font-size: 14px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;"/>
        <Button text="Calendrier" style="-fx-font-size: 14px; -fx-background-color: #007bff; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;"/>
    </HBox>

    <!-- Footer Section -->
    <HBox alignment="CENTER" spacing="10">
        <Label text="Auto École Management System" style="-fx-font-size: 12px; -fx-text-fill: #777;"/>
    </HBox>

</GridPane>

